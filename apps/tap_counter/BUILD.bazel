load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("//bzl/valdi:valdi_application.bzl", "valdi_application")
load("//bzl/valdi:valdi_module.bzl", "valdi_module")

# The minimal "Tap me" counter — Valdi's cell of the cross-framework benchmark
# (universal_ui/docs/benchmarks.md). A single .tsx, no native modules: a counter
# label + a button, behavior-identical to the native-Compose / compiled-Swift /
# wasm / React Native twins so the numbers isolate runtime overhead.

valdi_module(
    name = "tap_counter",
    srcs = glob([
        "**/*.ts",
        "**/*.tsx",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "//src/valdi_modules/src/valdi/valdi_core",
        "//src/valdi_modules/src/valdi/valdi_tsx",
    ],
)

# iOS device signing (benchmark runs): the Xcode-managed development profile
# for the shared benchmark bundle id — all cells across frameworks install
# under one id, one at a time (free personal teams allow few app ids).
local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: com.LoganShire.UniversalUI",
    tags = ["manual"],
    team_id = "9CLW2BBDAG",
)

# The on-device benchmark harness (iOS): a constructor-booted, env-gated
# runloop observer measuring commit-anchored startup/taps — see the file
# header. alwayslink so the constructor survives static linking.
objc_library(
    name = "ios_bench_harness",
    visibility = ["//visibility:public"],
    srcs = ["ios_bench/UUIBenchHarness.m"],
    alwayslink = True,
    sdk_frameworks = [
        "QuartzCore",
        "UIKit",
    ],
    tags = ["manual"],
)

valdi_application(
    name = "tap_counter_app",
    ios_bundle_id = "com.LoganShire.UniversalUI",
    ios_extra_deps = [":ios_bench_harness"],
    ios_families = ["iphone"],
    ios_provisioning_profile = ":_xcode_managed_profile",
    root_component_path = "App@tap_counter/TapCounter",
    title = "Tap Counter",
    version = "1.0.0",
    deps = [":tap_counter"],
)

